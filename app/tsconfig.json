  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-test",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
